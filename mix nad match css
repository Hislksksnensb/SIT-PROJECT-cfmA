body{
    background: #FFF8EE;
    margin: 0;
    padding: 0;
    font-size: 16px;
    text-align: center;
}

nav {
    display: flex;
    justify-content: center;
    gap: 40px;
    background-color: #B8DFA8;
    padding: 20px
}

nav a {
    color: #2E6F40;          
    text-decoration: none;
    padding: 8px 15px;
    border-radius: 8px;
    transition: 0.3s;
    font-weight: bold;
}

nav a:hover {
    background-color: #FFF8EE;   
    color: #2E6F40;              
}

main {
    max-width: 1000px;
    margin: 0 auto;
}


h1 {
    font: size 60px;
    color: rgb(0, 0, 0);
    margin-top: 10px;
    font-family: comic, sans-serif;
    padding: 0 100px;
}

 nav ul {
    list-style-type: none;
    background-color: #166534;
    padding: 10px;
    list-style-type: none
}



nav ul {
    background-color: #2E6F40;
    padding: 10px;
    list-style-type: none;
}

.box {
    height: 850px;
    width: 500px;
    margin-left: 50px;
    margin-top: 30px;
    border: 1px solid #fefdfb;
    border-radius: 12px;
    max-width: 500px;
    width: 100%;
    padding: 35px;
    margin-left: 250px;
    margin-top: 20px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);

    background-color: #fff;

}

.name

.name {
    display: block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    margin-top: 20px;
    margin-bottom: 40px;
    width: 100%
   
}


.name label {
    display: block;

    font-weight: bold;
    font-size: 15px;
    color: #0f172a;
    margin-bottom: 8px;
   
    margin-right: 300px;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
}
.payment{font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    font-size: 20px;
    display: inline-block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    margin-top: 20px;
    margin-bottom: 10px;
    width: 100%;
  margin-right: 10px;

}


.name input[type="text"] {
    display: block;
    width: 100%;

    max-width: 500px;

    height: 48px;

    padding: 0 14px;

    background-color: #ffffff;
    border: 1px solid #cbd5e1;

    border-radius: 8px;

    font-size: 16px;
    box-sizing: border-box;
}
.f1{
    display: block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    margin-top: 20px;
    margin-bottom: 20px;
    
}
.cvv{
    display: inline-block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    margin-top: 20px;
    margin-bottom: 20px;
    width: 100%;
    margin-left: 45px;
    
}
.secndbox{background-color: #f0fdf4;  
    border: 1px solid #bbf7d0;  
    border-radius: 12px;        
    width: 100%;                
    max-width: 420px;           
    padding: 28px;              
    margin-top: 20px;           
    box-sizing: border-box;     
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
 }
.cardnumber {
    
    margin-top: 20px;
    margin-bottom: 25px;
    width: 100%;
}
 .h3secndbox {
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    font-size: 20px;
    color: #065f46;              
    line-height: 1.5;           
    margin: 0;      }            
.layout{display: flex;           
    gap: 40px;                 
    align-items: flex-start; }

.btn-submit {
    margin-top: 20px;
    width: 100%;
    height: 50px;
    background-color: #15803d;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px #166534
}

.btn-submit:hover {
    background-color: #a3cfa4;
}

@media (max-width: 480px) {
    html, body {
        overflow-x: hidden !important; 
    }

   
    p1, p2, h1, h2, .header h1, .name, p {
        margin-left: 15px !important;  
        margin-right: auto !important;
        text-align: left !important;   
    }
    
    h2 {
        font-size: 26px !important;    
        margin-top: 15px !important;
    }

  
    .layout {
        display: flex !important;
        flex-direction: column !important; 
        justify-content: flex-start !important; 
        align-items: flex-start !important; 
        width: 100% !important;
        padding-left: 15px !important;      
        box-sizing: border-box !important;
    }

    .box {
        margin-left: 0 !important;     
        margin-right: auto !important; 
        height: auto !important;       
        padding: 20px !important;      
        width: 90% !important;         
        max-width: 500px !important; 
        box-sizing: border-box !important; 
    }

  
    .name label, .payment label,.address label, .postalcode label  {
        margin-right: 0 !important; 
        display: block !important;
        text-align: left !important;
    }

    
    .name input[type="text"], 
    .name select {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        height: 48px !important; 
        margin-top: 8px !important;
        margin-bottom: 15px !important;
        padding: 0 14px !important;
        background-color: #ffffff !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 8px !important;
        font-size: 16px !important;
        box-sizing: border-box !important;
    }
    nav {
        display: flex !important;
        justify-content: center !important;
        flex-wrap: wrap !important;  
        gap: 8px !important;        
        padding: 12px 5px !important; 
        width: 100% !important;
        box-sizing: border-box !important;
    }

    
    nav a {
        font-size: 14px !important; 
        padding: 6px 10px !important; 
    }


    p {
        width: 100% !important;
        margin-top: 10px !important;
        margin-bottom: 5px !important;
        font-weight: bold;
    }
