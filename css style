}

body {
    background: linear-gradient(to right, #7BB661 0%, #B8DFA8 50%, #CDE7C9 100%);
    font-size: 16px;
    margin: 0 20px;
    padding: 0;
}

.productrow {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin-top: 20px;
}

.products-links a {
    background-color: #2E6F40;
    color: #FFF8EE;
    padding: 12px 20px;
    margin: 5px;
    border-radius: 8px;
}

.products-links a:hover {
    background-color: #FFF8EE;
    color: #2E6F40;
}

body{
    animation: fadeIn 0.8s ease;
}

@keyframes fadeIn{
    from{
        opacity:0;
    }

    to{
        opacity:1;
    }
}

