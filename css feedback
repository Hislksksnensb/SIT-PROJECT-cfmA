 body{
    background: #FFF8EE;
    margin: 0;
    padding: 0;
    
    
}

nav {
    display: flex;
    justify-content: center;
    gap: 40px;
    background-color: #B8DFA8;
    padding: 20px
}

nav a {
    color: #2E6F40;          
    text-decoration: none;
    padding: 8px 15px;
    border-radius: 8px;
    transition: 0.3s;
    font-weight: bold;
}

nav a:hover {
    background-color: #FFF8EE;   
    color: #2E6F40;              
}
nav ul {
    background-color: #2E6F40;
    padding: 10px;
    list-style-type: none;
}
.rating-group {
    text-align: left;     
    margin-top: 25px;
    margin-bottom: 25px;
}

.rating-title {
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    font-weight: bold;
    font-size: 15px;
    color: #0f172a;
    margin-bottom: 12px;
}

.rating-label {
    display: flex;      
    align-items: center;
    gap: 10px;             
    font-size: 18px;       
    margin-bottom: 10px;  
    cursor: pointer;
    width: fit-content;
}


.rating-label input[type="radio"] {
    accent-color: #15803d; 
    width: 18px;            
    height: 18px;
}
.name {
    display: block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    margin-top: 20px;
    margin-bottom: 25px;
    width: 100%;
    
}
h1{ font-size: 60px;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    font-weight: bold;
    color: #0f172a;
    margin-bottom: 20px;
}


.name label {
    display: block;
    font-weight: bold;
    font-size: 15px;
    color: #0f172a;
    margin-bottom: 8px;
    margin-right: 300px;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
}

.name input[type="text"] {
    display: block;
    width: 100%;
    max-width: 500px;
    height: 48px;
    padding: 0 14px;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 16px;
    box-sizing: border-box;
}
p1{
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    font-weight: bold;
    font-size: 50px;
    color: #0f172a;
   align-items: center;
    margin-bottom: 20px;
    margin-left: 300px;
}
h2{
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    font-weight: bold;
    font-size: 20px;
    color: #0f172a;
    
}

.rating-title {
    font-size: 16px;
    font-weight: normal;
    margin-bottom: 15px;
    color: #333;
}


.rating-group {
    display: flex;
    flex-direction: column; 
    gap: 12px;             
    margin-top: 15px;
    margin-bottom: 25px;
}


.rating-label {
    display: flex;
    align-items: center;   
    gap: 8px;              
    cursor: pointer;
    white-space: nowrap;    
}


.box {
  
    height: 800px;
    width: 100%;
    max-width: 500px;
    margin-left:300px;   
    padding: 35px;
    border: 1px solid #fefdfb;
    border-radius: 12px;
    background-color: #fff;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
}


.feedback-comment {
    display: block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    margin-top: 20px;
    margin-bottom: 25px;
    width: 100%;
}


.feedback-comment label {
    display: block;
    font-weight: bold;
    font-size: 15px;
    color: #0f172a;
    margin-bottom: 8px;
    text-align: left; 
}


.feedback-comment textarea {
    display: block;
    width: 100%;
    max-width: 500px;
    padding: 14px;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 16px;
    box-sizing: border-box;
    font-family: inherit; 
    resize: vertical;    
    min-height: 120px;   
    transition: border-color 0.2s ease;
}

.feedback-comment textarea:focus {
    outline: none;
    border-color: #15803d; 
}
.btn-submit {
    margin-top: 20px;
    width: 100%;
    height: 50px;
    background-color: #B8DFA8;
    color: #15803d;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px #424644
}

.btn-submit:hover {
    background-color: #a3cfa4;
}
@media (max-width: 768px) {
    html, body {
        overflow-x: hidden !important; 
    }
    p1, p2, h1, .header h1, h2, .rating-title {
        margin-left: 15px !important;  
        margin-right: auto !important;
        text-align: left !important;   
    }
    
    h1 {
        font-size: 34px !important;    
        padding: 0 15px !important;
    }
    
    .header h1 {
        font-size: 30px !important;
        padding: 0 !important;
    }

    h2 {
        font-size: 22px !important; 
    }

    .boxcontainer, .layout {
        display: flex !important;
        flex-direction: column !important; 
        justify-content: flex-start !important; 
        align-items: flex-start !important; 
        width: 100% !important;
        padding-left: 15px !important;      
        box-sizing: border-box !important;
    }

    .box, .secndbox, .thirdbox {
        margin-left: 0 !important;     
        margin-right: auto !important; 
        height: auto !important;       
        padding: 20px !important;      
        width: 90% !important;         
        max-width: 90% !important; 
        box-sizing: border-box !important; 
    }


    .name, .feedback-comment, .rating-group, .submit {
        text-align: left !important;
        box-sizing: border-box !important;
        width: 100% !important;
    }


    .name label, .feedback-comment label {
        margin-right: 0 !important; 
        text-align: left !important;
    }

    .feedback-comment textarea {
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    /* Make star radio options stack neatly and align cleanly on the left */
    .rating-group {
        display: flex !important;
        flex-direction: column !important;
        gap: 10px !important;
        padding-left: 5px !important;
    }

    .rating-label {
        display: flex !important;
        align-items: center !important;
        text-align: left !important;
        font-size: 18px !important; /* Slightly enlarged emoji size for easier finger clicking */
    }
}


.btn-submit:hover {
    background-color: #a3cfa4;
}
