body{
    background: #FFF8EE;
    margin: 0;
    padding: 0;
    font-size: 16px;
    text-align: center;
}

nav {
    display: flex;
    justify-content: center;
    gap: 40px;
    background-color: #B8DFA8;
    padding: 20px
}

nav a {
    color: #2E6F40;          
    text-decoration: none;
    padding: 8px 15px;
    border-radius: 8px;
    transition: 0.3s;
    font-weight: bold;
}

nav a:hover {
    background-color: #FFF8EE;   
    color: #2E6F40;              
}

main{
  max-width: 1000px;
  margin: 0 auto;
}

body{
    animation: fadeIn 0.8s ease;
}

@keyframes fadeIn{
    from{
        opacity:0;
    }

    to{
        opacity:1;
    }
}

.accordion{
    width: 60%;
    margin: 18px auto;
    background: #B8DFA8;
    border-radius: 18px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
}

.accordion summary{
    padding: 20px;
    font-size: 26px;
    font-weight: bold;
    color: #2E6F40;
    cursor: pointer;
}
.accordion summary:hover{
    background: #FFF8EE;
    color:#2E6F40;
}

.accordion .content{
    padding:25px;
    background:white;
    color:#333;
    font-size:20px;
    line-height:1.8;
}

h1 ,h2 ,h3{
    font-size: 30px;
    color: #2E6F40;
}

.cta {
    text-align: center;
    margin: 40px 0;
}

.cta h2 {
    color: #2E6F40;
    font-size: 30px;
}

.cta-btn {
    display: inline-block;
    background-color: #B8DFA8;
    color: #2E6F40;
    padding: 15px 30px;
    border-radius: 12px;
    text-decoration: none;
    font-size: 18px;
    font-weight: bold;
    transition: 0.3s;
}

.cta-btn:hover {
    background-color: #FFF8EE;
    transform: scale(1.05);
    box-shadow: 0 8px 18px rgba(0,0,0,0.2);
}

.team-description{
    color:#2E6F40;
    text-align:center;
    margin-bottom:20px;
}

.team-table{
    width:70%;
    margin:30px auto;
    border-collapse:collapse;
    background:#FFF8EE;
    border-radius:12px;
    overflow:hidden;
}

.team-table th{
    background:#B8DFA8;
    color:#2E6F40;
    padding:15px;
    font-size:20px;
}

.team-table td{
    border:1px solid #B8DFA8;
    padding:15px;
    color:#2E6F40;
    text-align:center;
}

h1 ,h2 ,h3{
    font-size: 30px;
    color: #2E6F40;
}

@media (max-width: 480px) {
    html, body {
        overflow-x: hidden !important; 
    }

   
    p1, p2, h1, h2, .header h1, .name, p {
        margin-left: 15px !important;  
        margin-right: auto !important;
        text-align: left !important;   
    }
    
    h2 {
        font-size: 26px !important;    
        margin-top: 15px !important;
    }

  
    .layout {
        display: flex !important;
        flex-direction: column !important; 
        justify-content: flex-start !important; 
        align-items: flex-start !important; 
        width: 100% !important;
        padding-left: 15px !important;      
        box-sizing: border-box !important;
    }

    .box {
        margin-left: 0 !important;     
        margin-right: auto !important; 
        height: auto !important;       
        padding: 20px !important;      
        width: 90% !important;         
        max-width: 500px !important; 
        box-sizing: border-box !important; 
    }

  
    .name label, .payment label,.address label, .postalcode label  {
        margin-right: 0 !important; 
        display: block !important;
        text-align: left !important;
    }

    
    .name input[type="text"], 
    .name select {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        height: 48px !important; 
        margin-top: 8px !important;
        margin-bottom: 15px !important;
        padding: 0 14px !important;
        background-color: #ffffff !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 8px !important;
        font-size: 16px !important;
        box-sizing: border-box !important;
    }
    nav {
        display: flex !important;
        justify-content: center !important;
        flex-wrap: wrap !important;  
        gap: 8px !important;        
        padding: 12px 5px !important; 
        width: 100% !important;
        box-sizing: border-box !important;
    }

    
    nav a {
        font-size: 14px !important; 
        padding: 6px 10px !important; 
    }


    p {
        width: 100% !important;
        margin-top: 10px !important;
        margin-bottom: 5px !important;
        font-weight: bold;
    }
}
