body{
    background: #FFF8EE;
    margin: 0;
    padding: 0;
    font-size: 16px;
    text-align: center;
}

nav {
    display: flex;
    justify-content: center;
    gap: 40px;
    background-color: #B8DFA8;
    padding: 20px
}

nav a {
    color: #2E6F40;          
    text-decoration: none;
    padding: 8px 15px;
    border-radius: 8px;
    transition: 0.3s;
    font-weight: bold;
}

nav a:hover {
    background-color: #FFF8EE;   
    color: #2E6F40;              
}
