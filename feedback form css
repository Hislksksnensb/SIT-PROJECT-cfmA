body{
    background: #FFF8EE;
    margin: 0;
    padding: 0;
    font-size: 16px;
    text-align: center;
}

nav {
    display: flex;
    justify-content: center;
    gap: 40px;
    background-color: #B8DFA8;
    padding: 20px
}

nav a {
    color: #2E6F40;          
    text-decoration: none;
    padding: 8px 15px;
    border-radius: 8px;
    transition: 0.3s;
    font-weight: bold;
}

nav a:hover {
    background-color: #FFF8EE;   
    color: #2E6F40;              
}

main {
    max-width: 1000px;
    margin: 0 auto;
}


h1 {
    font: size 60px;
    color: rgb(0, 0, 0);
    margin-top: 10px;
    font-family: comic, sans-serif;
    padding: 0 100px;
}

 nav ul {
    list-style-type: none;
    background-color: #166534;
    padding: 10px;
    list-style-type: none
}



/* Navigation List Container */
nav ul {
    background-color: #2E6F40;
    /* Matched green instead of dark blue */
    padding: 10px;
    list-style-type: none;
}

.box {
    height: 850px;
    width: 500px;
    margin-left: 50px;
    margin-top: 30px;
    border: 1px solid #fefdfb;
    /* Thin, light-gray crisp border */
    border-radius: 12px;
    max-width: 500px;
    /* Prevents the box from getting too wide */
    width: 100%;
    padding: 35px;
    /* Generous breathing room inside the box */
    margin-left: 250px;
    /* Aligns it nicely to your left margin */
    margin-top: 20px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
    /* Soft professional shadow */
    background-color: #fff;

}

.name

/* 1. This handles ONLY the overall layout container */
.name {
    display: block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    margin-top: 20px;
    margin-bottom: 40px;
    width: 100%;

    /* Allows the whole section to use the available space */
}

/* 2. This targets ONLY the text word "Full name:" */
.name label {
    display: block;
    /* Forces the input box to drop to the next line */
    font-weight: bold;
    font-size: 15px;
    color: #0f172a;
    margin-bottom: 8px;
    /* Space between the word and the writing box */
    margin-right: 300px;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
}
.payment{font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    font-size: 20px;
    display: inline-block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    margin-top: 20px;
    margin-bottom: 10px;
    width: 100%;
  margin-right: 10px;
    /* Allows the whole section to use the available space */
}

/* 3. This targets ONLY the actual writing text box */
.name input[type="text"] {
    display: block;
    width: 100%;
    /* Makes ONLY the writing box stretch nice and wide */
    max-width: 500px;
    /* Prevents the input box from getting too long */
    height: 48px;
    /* Gives it that nice chunky, clickable size */
    padding: 0 14px;
    /* Keeps your typing away from the left border edge */
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    /* This adds the border to the box, NOT the words */
    border-radius: 8px;
    /* Smoothly rounds the corners of the box */
    font-size: 16px;
    box-sizing: border-box;
}
.f1{
    display: block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    margin-top: 20px;
    margin-bottom: 20px;
    
}
.cvv{
    display: inline-block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    margin-top: 20px;
    margin-bottom: 20px;
    width: 100%;
    margin-left: 45px;
    /* Allows the whole section to use the available space */
}
