.name/* 1. This handles ONLY the overall layout container */
.name {
    display: block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif; 
    margin-top: 20px;
    margin-bottom: 25px;
    width: 100%; /* Allows the whole section to use the available space */
}

/* 2. This targets ONLY the text word "Full name:" */
.name label {
    display: block;      /* Forces the input box to drop to the next line */
    font-weight: bold;
    font-size: 15px;
    color: #0f172a;
    margin-bottom: 8px;  /* Space between the word and the writing box */
   margin-right:300px;
   font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif; 
}

/* 3. This targets ONLY the actual writing text box */
.name input[type="text"] {
    display: block;
    width: 100%;         /* Makes ONLY the writing box stretch nice and wide */
    max-width: 500px;    /* Prevents the input box from getting too long */
    height: 48px;        /* Gives it that nice chunky, clickable size */
    padding: 0 14px;     /* Keeps your typing away from the left border edge */
    background-color: #ffffff;
    border: 1px solid #cbd5e1; /* This adds the border to the box, NOT the words */
    border-radius: 8px;  /* Smoothly rounds the corners of the box */
    font-size: 16px;
    box-sizing: border-box;
}

