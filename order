<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> 
    <title>Bakers Bastion</title>
    <link rel="stylesheet" href="CSS/stylev.css">
</head>

<body>
    <nav>
        <a href="index.html">Home</a>
        <a href="order.html">Order</a>
        <a href="abt us.html">About Us</a>
        <a href="products.html">Products</a>
        <a href="contactus.html">Contact us</a>
    </nav>

    <div class="header">
        <h1>Bakers Bastion</h1>
    </div>

    <!-- Fixed invalid tag names to valid classes -->
    <p class="p1">Complete your order</p>
    <p class="p2">Please select items and payment details below</p>
    
    <div class="layout">
        <div class="boxcontainer">
            <!-- Moved form outside the box container layout loop to keep tag closure nesting legal -->
            <form action="feedbackform.html" method="GET">
                <div class="box">

                    <div class="name">
                        <label for="custname">name:</label>
                        <input type="text" name="custname" id="custname" required>
                    </div>
                    
                    <div class="order1">
                        <label for="order1">First order:</label>
                        <input type="text" name="order1" id="order1" required>
                    </div>
                    <div class="order2">
                        <label for="order2">Second order:</label>
                        <input type="text" name="order2" id="order2">
                    </div>
                    <div class="order3">
                        <label for="order3">Third order:</label>
                        <input type="text" name="order3" id="order3">
                    </div>
                   
                    <div class="address">
                        <label for="address">Delivery Address: *if pick up at store skip this step</label>
                        <input type="text" name="address" id="address">
                    </div>
                    
                    <!-- Fixed space in class name to valid matching format -->
                    <div class="postal-code">
                        <label for="postalcode">Postal Code:</label>
                        <input type="number" name="postalcode" id="postalcode">
                    </div>
                    
                    <div class="payment">
                        <label><input type="radio" name="size" value="cod" checked> Cash on delivery/cash in store</label>
                        <label><input type="radio" name="size" value="card"> Card payment</label>
                        <br>
                        <div class="font">
                            *if cash on delivery/in store, chosen skip this step*
                        </div>
                    </div>
                    
                    <div class="cardnumber">
                        <label for="cardnumber">Card number:</label>
                        <input type="number" name="cardnumber" id="cardnumber" placeholder="1234 5678 9012 3456">
                    </div>
                    <div class="expiry">
                        <label for="expiry">Expiry date:</label>
                        <input type="number" name="expiry" id="expiry" placeholder="MM/YY">
                    </div>
                    <div class="cvv">
                        <label for="cvv">CVV:</label>
                        <input type="number" name="cvv" id="cvv" placeholder="123">
                    </div>
                    
                    <div class="submit">
                        <button type="submit" class="btn-submit">Submit Order</button>
                    </div>
                </div>
            </form>
          
            <div class="secndbox">
                <h3 class="h3secndbox">📋 Order Pricing</h3>
                <p>• Single Custom Selection: <strong>$35.00 flat</strong></p>
                <p>• Delivery / Logistics Fee: <strong>$5.00</strong></p>
              
                <p>*Final calculated summary will be printed directly on your physical receipt at checkout.*</p>
            
                <div class="thirdbox">
                    <h3 class="h3third">*Important Notice* over 3 orders will need to be placed in person at our store, please contact us for more information <span class="keep-together">+65 3738194</span></h3>
                </div>
            </div>
        </div>
    </div>

</body>
</html>



body {
    background: #FFF8EE;
    margin: 0;
    padding: 0;
    font-size: 16px;
    text-align: center;
}

nav {
    display: flex;
    justify-content: center;
    gap: 40px;
    background-color: #B8DFA8;
    padding: 20px;
}

nav a {
    color: #2E6F40;          
    text-decoration: none;
    padding: 8px 15px;
    border-radius: 8px;
    transition: 0.3s;
    font-weight: bold;
}

nav a:hover {
    background-color: #FFF8EE;   
    color: #2E6F40;              
}

main {
    max-width: 1000px;
    margin: 0 auto;
}

h1 {
    font-size: 60px;
    color: rgb(0, 0, 0);
    margin-top: 10px;
    font-family: comic, sans-serif;
    padding: 0 100px;
}

nav ul {
    list-style-type: none;
    background-color: #309f5b;
    padding: 10px;
}

.header h1 {
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    font-size: 50px;
    color: #0f172a;
    margin-top: 10px;
    padding: 0 0;
    display: block;
    margin-left: 20px;
    text-align: left;
}

.p1 {
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    font-size: 30px;
    color: rgb(0, 0, 0);
    margin-top: 10px;
    padding: 0 10px;
    display: block;
    margin-left: 250px;
    text-align: left;
    font-weight: bold;
    margin-top: 60px;
}

.p2 {
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    font-size: 20px;
    color: #707e94;
    margin-top: 10px;
    padding: 0 10px;
    display: block;
    margin-left: 250px;
    text-align: left;
    margin-top: 20px;
}

.box {
    height: 850px;
    width: 100%;
    margin: 20px;
    border: 1px solid #fefdfb;
    border-radius: 12px;
    max-width: 500px;
    padding: 35px;
    margin-left: 250px;
    margin-top: 20px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
    background-color: #fff;
}


.secndbox {
    background-color: #f0fdf4;  
    border: 1px solid #bbf7d0;  
    border-radius: 12px;        
    width: 100%;                
    max-width: 300px;           
    padding: 28px;              
    margin-top: 20px;           
    box-sizing: border-box;     
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
}

.h3secndbox {
    margin-top: 10px; 
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    font-size: 20px;
    line-height: 1.5;           
    margin: 0;      
}            

.layout {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 40px;
    align-items: flex-start;
}

.btn-submit {
    margin-top: 20px;
    width: 100%;
    height: 50px;
    background-color: #15803d;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px #166534
}

.btn-submit:hover {
    background-color: #a3cfa4;
}

.address {
    display: block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    margin-top: 20px;
    margin-bottom: 25px;
    width: 100%;
}

.address label {
    display: block;
    font-weight: bold;
    font-size: 15px;
    color: #0f172a;
    margin-bottom: 8px;
    margin-right: 300px;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
}

.address input[type="text"] {
    display: block;
    width: 100%;
    max-width: 500px;
    height: 48px;
    padding: 0 14px;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 16px;
    box-sizing: border-box;
}

.postalcode {
    display: block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    margin-top: 20px;
    margin-bottom: 25px;
    width: 100%;
}
.postalcode label {
    display: block;
    font-weight: bold;
    font-size: 15px;
    color: #0f172a;
    margin-bottom: 8px;
    margin-right: 300px;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
}

.postalcode input[type="text"] {
    margin-left: 20px;
    display: block;
    width: 70%;
    max-width: 500px;
    height: 38px;
    padding: 0 14px;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 16px;
    box-sizing: border-box;
}

.thirdbox {
    background-color: #f0fdf4;  
    border: 1px solid #bbf7d0;  
    border-radius: 12px;        
    width: 100%;                
    max-width: 300px;           
    padding: 28px;              
    margin-top: 10px;           
    box-sizing: border-box;     
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
}

.h3third {
    display: block;
    margin-top: 10px; 
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    font-size: 20px;
    line-height: 1.5;           
    margin: 0;      
}   

.keep-together {
    white-space: nowrap;
}

.boxcontainer {
    display: flex;
    flex-wrap: wrap; /* Added wrapper support so boxes drop below cleanly */
}


.name, .order1, .order2, .order3 {
    display: block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    margin-top: 20px;
    margin-bottom: 25px;
    width: 100%;
}

.name label, .order1 label, .order2 label, .order3 label {
    display: block;
    font-weight: bold;
    font-size: 15px;
    color: #0f172a;
    margin-bottom: 8px;
    margin-right: 300px;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
}

.name input[type="text"], .order1 input[type="text"], .order2 input[type="text"], .order3 input[type="text"] {
    display: block;
    width: 100%;
    max-width: 500px;
    height: 48px;
    padding: 0 14px;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 16px;
    box-sizing: border-box;
}

.payment {
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    font-size: 20px;
    display: inline-block;
    margin-top: 20px;
    margin-bottom: 10px;
    width: 100%;
    margin-right: 10px;
}

.expiry {
    margin-right: 10px;
    display: inline-block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    margin-top: 20px;
    margin-bottom: 10px;
    width: 100%;
}

.cvv {
    display: inline-block;
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    margin-top: 20px;
    margin-bottom: 20px;
    width: 100%;
    margin-left: 0;
}


@media (max-width: 768px) {
    html, body {
        overflow-x: hidden !important; 
    }
        /* 1. Squeeze the nav bar container so nothing overflows the glass */
    nav {
        display: flex !important;
        justify-content: center !important;
        flex-wrap: wrap !important;  
        gap: 8px !important;         
        padding: 12px 5px !important;
        width: 100% !important;
        box-sizing: border-box !important;
    }

    /* 2. 
    nav a {
        font-size: 14px !important; 
        padding: 6px 10px !important; 
    }


    
    .p1,. p2, h1, .header h1 {
        margin-left: 15px !important;  
        margin-right: auto !important;
        text-align: left !important;   
    }
    
    h1 {
        font-size: 34px !important;    
        padding: 0 15px !important;
    }
    
    .header h1 {
        font-size: 30px !important;
        padding: 0 !important;
    }

    /* 2. Anchor the main layout content container to the left wall */
    .boxcontainer, .layout {
        display: flex !important;
        flex-direction: column !important; 
        justify-content: flex-start !important; 
        align-items: flex-start !important; 
        width: 100% !important;
        padding-left: 15px !important;      
        box-sizing: border-box !important;
    }

    /* 3. Drop center margins so the boxes sit firmly on the left side */
    .box, .secndbox, .thirdbox {
        margin-left: 0 !important;     
        margin-right: auto !important; 
        height: auto !important;       
        padding: 20px !important;      
        width: 90% !important;         
        max-width: 90% !important; 
        box-sizing: border-box !important; 
    }

    /* 4. Lock form text inputs to the left */
    .name, .order1, .order2, .order3, .address, .postalcode {
        text-align: left !important;
        box-sizing: border-box !important;
    }

    .name label, .order1 label, .order2 label, .order3 label, .address label, .postalcode label {
        margin-right: 0 !important; 
    }
    
    .postalcode input[type="text"] {
        margin-left: 0 !important;
        width: 100% !important;
    }
}
.font{
    font-family: "Inter", "Geist Sans", "Segoe UI", sans-serif;
    font-size: 15px;
    
}



